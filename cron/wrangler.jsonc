// fogatlas-cron: dispatches .github/workflows/forecast.yml on a reliable
// clock (see src/index.js for why). Deploy from this directory:
//   npx wrangler@4.167.0 deploy
// The one secret is set separately and never lives in this file:
//   npx wrangler@4.167.0 secret put GH_PAT
{
  "$schema": "https://unpkg.com/wrangler@4.167.0/config-schema.json",
  "name": "fogatlas-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "5488aa3505290f21c3be9c32b2a5949c",
  // no HTTP surface at all: no workers.dev hostname, no preview URLs, no routes
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "25 * * * *", // hourly at :25 — the same minute forecast.yml's own cron asks for
      "40 10 * * *" // a second chance for the daily bake (first run at/after 10Z bakes)
    ]
  },
  "vars": {
    "GH_REPO": "travis735/fog-atlas",
    "GH_WORKFLOW": "forecast.yml",
    "GH_REF": "main"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
